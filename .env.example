# Copy to .env.local and fill in from your Supabase project (Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The web address the app runs at, used in sign-up emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WorkoutX stock exercise demos (server only, never NEXT_PUBLIC). From workoutxapp.com/dashboard.html
WORKOUTX_API_KEY=
